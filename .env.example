# --- Novarum account the bot logs in as (a dedicated bot account, or your own for a true userbot) ---
NOVARUM_URL=https://orwell.ing
# Either a session token (the `session_token` cookie from the web app)...
NOVARUM_SESSION_TOKEN=
# ...or username/password. MFA prompts for the code on first start; the session is cached in .data/.
NOVARUM_USERNAME=
NOVARUM_PASSWORD=

# Who may drive Amp, comma-separated @user:homeserver handles. Runs bill to your Amp key, so
# keep this tight. Defaults to just the logged-in account.
ALLOWED_HANDLES=
# Extra handles that trigger the bot besides the logged-in account's own handle (optional).
TRIGGER_HANDLES=

# --- Amp ---
# From https://ampcode.com/settings
AMP_API_KEY=
# Amp project for new orb threads (namespace/name, owner/repo, or repo URL). Empty = orb with no repo.
AMP_PROJECT=
# low | medium | high | ultra (empty = Amp default)
AMP_MODE=
# private | unlisted | workspace | group (empty = Amp default, workspace)
AMP_VISIBILITY=

# How many recent channel messages to give Amp as context on a new thread (20-100)
CONTEXT_MESSAGES=20
