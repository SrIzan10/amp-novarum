# --- Novarum ---
# The Anchor homeserver the bot lives on
NOVARUM_URL=https://orwell.ing
# The bot token from the developer panel (create a bot there; slash commands register themselves on start)
NOVARUM_BOT_TOKEN=

# The one @user:homeserver handle allowed to drive Amp. Runs bill to your Amp key.
# Required: only this handle can start runs, use /model and /effort, or press Stop.
OWNER_HANDLE=
# Extra handles that trigger the bot besides the bot's own handle (optional).
TRIGGER_HANDLES=

# --- Amp ---
# From https://ampcode.com/settings
AMP_API_KEY=
# Run new threads on one of your machines: the ID of an `amp --no-tui` runner (see `amp runner list` on
# that machine, or start it with --runner-id <id> for a stable one). Empty = run in an orb instead.
AMP_RUNNER_ID=
# Absolute directory the runner serves for new threads, e.g. /home/you/amp/novarum (empty = its starting dir)
AMP_RUNNER_DIR=
# Amp project for new orb threads, ignored when AMP_RUNNER_ID is set (namespace/name, owner/repo, or repo URL). Empty = orb with no repo.
AMP_PROJECT=
# Agent mode (empty = external-agent:claude-code, i.e. Claude Code). low | medium | high | ultra for Amp's agent.
AMP_MODE=
# Default model for Claude Code: an alias (opus, sonnet, haiku) or a model ID such as claude-sonnet-5-5.
# Empty = Claude Code's default. Change it from chat with `/model`.
AMP_MODEL=
# none | minimal | low | medium | high | xhigh | max (empty = mode default). Change it with `/effort`.
AMP_EFFORT=
# private | unlisted | workspace | group (empty = Amp default, workspace)
AMP_VISIBILITY=

# How many recent channel messages to give Amp as context on a new thread (20-100)
CONTEXT_MESSAGES=20
